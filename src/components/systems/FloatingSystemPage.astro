---
import type { ObservatoryData, ObservatorySystem } from '../../data/observatory';
import type { SiteLocale } from '../../i18n/config';
const { system: s, data } = Astro.props as { system: ObservatorySystem; data: ObservatoryData; locale: SiteLocale };
const { systems, relationships, ui } = data;
const termPaths: Record<string, string> = { Dive: 'dive', Anchor: 'anchor', Reach: 'anchor/reach' };
const explanationParts = s.id === 'redactory' ? s.explanation.split(/\b(Dive|Anchor|Reach)\b/g) : [s.explanation];
---
      <p class="observatory-kicker">{s.title}</p>
      <h2 id="observatory-page-title" tabindex="-1">{s.summary}</h2>
      <p class="observatory-explanation">{explanationParts.map(part => s.id === 'redactory' && termPaths[part] ? <a href={`#redactory/${termPaths[part]}`} data-observatory-link data-concept-ref={part.toLowerCase()}>{part}</a> : part)}</p>
      <footer class="observatory-page__footer"><a href={s.source}>{ui.read} ↗</a>{s.destination !== s.source && <a href={s.destination} data-system-panel-link data-system-launch={s.id} data-transition-trigger="observatory-system">{ui.explore} ↗</a>}</footer>
      {s.image && <figure class="observatory-image"><img src={s.image.src} alt={s.image.alt} loading="lazy" decoding="async" />{s.image.caption && <figcaption>{s.image.caption}</figcaption>}</figure>}
      <div class="observatory-concepts" data-concept-nodes aria-label={ui.concepts}></div>
      <div class="observatory-system-references">
        {relationships.filter(r => r.source === s.id || r.target === s.id).map(r => {
          const other = systems.find(n => n.id === (r.source === s.id ? r.target : r.source))!;
          return <p><span>{r.summary}</span> <a href={`#${other.id}`} data-observatory-link data-related-system={other.id}>{other.title} <span aria-hidden="true">↗</span></a></p>;
        })}
      </div>
