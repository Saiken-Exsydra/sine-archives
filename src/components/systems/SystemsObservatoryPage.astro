---
import MainLayout from '../../layouts/MainLayout.astro';
import { localizedPath, type SiteLocale } from '../../i18n/config';
import { getArchiveNavLabels, sectionLabel } from '../../i18n/ui';
import { getObservatory } from '../../data/observatory';
import ArchiveField from './ArchiveField.astro';
import FloatingSystemPage from './FloatingSystemPage.astro';
import ArchiveIntroduction from './ArchiveIntroduction.astro';
import ArchiveSphere from './ArchiveSphere.astro';
import SystemNode from './SystemNode.astro';
import DestinationPanel from './DestinationPanel.astro';
import '../../styles/observatory.css';
const { locale = 'en' } = Astro.props as { locale?: SiteLocale };
const data = getObservatory(locale);
const { systems, relationships, archive, ui } = data;
const nav = getArchiveNavLabels(locale);
---
<MainLayout active="systems" pageTitle={`${ui.title} - SiNE Archives`} locale={locale} navVariant="section" pageClass="systems-observatory-page" routeKind="section-index" transitionProfile="section-index" navTrail={[
  { label: nav.index, href: localizedPath(locale, '/') },
  { label: sectionLabel(locale, 'systems'), href: localizedPath(locale, '/systems/') },
  { label: locale === 'en' ? 'Observatory' : 'Observatório' },
]}>
  <section class="observatory-root" data-observatory-root data-locale={locale}>
    <ArchiveField />
    <header class="observatory-hero">
      <p class="observatory-kicker">{ui.kicker}</p>
      <h1>{ui.title}</h1>
      <p class="observatory-subtitle">{ui.subtitle}</p>
    </header>
    <div class="observatory-tools">
      <button type="button" data-follow-toggle aria-pressed="false">{ui.follow}</button>
      <button type="button" data-relationships-toggle aria-pressed="false">{ui.relationships}</button>
      <button type="button" data-compare-toggle aria-pressed="false">{ui.compare}</button>
    </div>
    <p class="observatory-guide" data-follow-guide aria-live="polite" hidden>{ui.followPrompt}</p>
    <div class="observatory-stage" data-active-system="" data-focused="false">
      <svg class="observatory-tether" aria-hidden="true"><path data-page-tether /></svg>
      <div class="observatory-aperture">
        <div class="observatory-depth" data-depth-layer>
        <ArchiveSphere compact />
        <svg class="observatory-svg" viewBox="0 0 1000 800" preserveAspectRatio="none" aria-label={ui.relationships}>
          <ellipse class="observatory-orbit" cx="500" cy="400" rx="325" ry="285" />
          <ellipse class="observatory-orbit" cx="500" cy="400" rx="205" ry="175" />
          {systems.map(s => <path data-svg-connector={s.id} pathLength="1" d={`M500 400 Q${s.x * 10} 400 ${s.x * 10} ${s.y * 8}`} />)}
          {relationships.map(r => {
            const a = systems.find(s => s.id === r.source)!;
            const b = systems.find(s => s.id === r.target)!;
            return <path data-relationship-path={r.id} data-relationship-edge={r.id} role="button" tabindex="-1" aria-hidden="true" aria-label={`${a.title} — ${b.title}: ${r.summary}`} pathLength="1" d={`M${a.x * 10} ${a.y * 8} Q500 400 ${b.x * 10} ${b.y * 8}`} />;
          })}
          <circle data-travel-point r="4" cx="500" cy="400" />
          <g data-relation-pulses aria-hidden="true"></g>
        </svg>
        <a class="observatory-archive" href="#archive" data-observatory-link data-archive-node><span aria-hidden="true">·</span>Archive</a>
        <div class="observatory-nodes" aria-label={sectionLabel(locale, 'systems')}>
          {systems.map(s => <SystemNode {...s} href={`#${s.id}`} action={s.title} />)}
        </div>
      </div>
      </div>
      <div class="observatory-comparison" data-comparison-plates aria-live="polite" hidden></div>
      <section class="observatory-page" data-floating-page aria-labelledby="observatory-page-title" hidden>
        <div class="observatory-page__seam" aria-hidden="true"></div>
        <a href="#map" data-observatory-link class="observatory-return">← {ui.map}</a>
        <nav class="observatory-lineage" aria-label={ui.lineage} data-concept-lineage></nav>
        <div data-page-body></div>
      </section>
    </div>
    <section class="observatory-relations" data-relations-panel hidden aria-label={ui.relationships}>
      <p data-relations-instruction aria-live="polite">{ui.relationPrompt}</p>
      <div class="observatory-relations__links">
        {relationships.map(r => <button type="button" data-relationship={r.id} aria-pressed="false">{systems.find(s => s.id === r.source)!.title}<span aria-hidden="true"> ─ </span>{systems.find(s => s.id === r.target)!.title}</button>)}
      </div>
      <div data-relationship-detail aria-live="polite"></div>
    </section>
    <details class="observatory-destinations">
      <summary>{ui.destinations}</summary>
      <div class="observatory-destinations__grid">
        {systems.map(s => <DestinationPanel title={s.title} subtitle={s.summary} status="" cta={ui.explore} href={s.destination} systemId={s.id} transitionTrigger="observatory-system" active />)}
      </div>
    </details>
    <div class="observatory-definition" id="observatory-definition" data-definition popover="auto" role="dialog" aria-labelledby="observatory-definition-title">
      <h3 id="observatory-definition-title"></h3><p data-definition-body></p>
      <a data-definition-source>{ui.read}</a>
      <button type="button" data-definition-close>{ui.close} ×</button>
    </div>
    <div class="observatory-entrance" data-entrance hidden aria-hidden="true"><div class="observatory-entrance__line"></div><i class="observatory-entrance__point"></i></div>
    <script is:inline type="application/json" data-observatory-data set:html={JSON.stringify(data).replace(/</g, '\\u003c')} />
    {systems.map(s => <template data-system-template={s.id}><FloatingSystemPage system={s} data={data} locale={locale} /></template>)}
    <template data-archive-template><ArchiveIntroduction archive={archive} read={ui.read} /></template>
    <noscript><p>{ui.destinations}</p>{systems.map(s => <p><a href={s.destination}>{s.title}</a> — {s.summary}</p>)}</noscript>
  </section>
</MainLayout>
<script>
  import { initObservatory } from '../../scripts/observatory/controller';
  window.registerPageInit?.('systems-observatory', initObservatory, { persistent: true });
</script>
