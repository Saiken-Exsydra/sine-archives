---
type Props = {
  id: string;
  title: string;
  summary: string;
  logo: string;
  angle: number;
  x: number;
  y: number;
  href?: string;
  action?: string;
  transitionName?: string;
  motionProfile?: string;
};

const { id, title, summary, logo, angle, x, y, href, transitionName, motionProfile } = Astro.props;
const tracery: Record<string, string> = {
  branch: 'M50 8 V32 L28 50 M50 32 L72 50 M28 50 L18 72 M28 50 L38 72 M72 50 L62 72 M72 50 L82 72',
  echo: 'M18 50 A32 32 0 0 1 82 50 M10 50 A40 40 0 0 0 90 50',
  interval: 'M20 38 H80 M20 50 H80 M20 62 H80',
  thread: 'M42 8 Q58 35 42 58 T42 92 M58 8 Q42 35 58 58 T58 92',
  unfold: 'M50 80 Q12 50 28 20 Q50 28 50 80 M50 80 Q88 50 72 20 Q50 28 50 80',
  horizon: 'M12 42 Q50 36 88 42 M8 54 H92 M18 65 Q50 69 82 65',
};
const Tag = href ? "a" : "button";
---

<Tag
  class="observatory-node"
  type={href ? undefined : "button"}
  href={href}
  data-system-node={id}
  data-observatory-link
  data-system-transition-name={transitionName}
  data-angle={angle}
  data-motion-profile={motionProfile}
  style={`--node-x: ${x}%; --node-y: ${y}%;`}
  aria-label={title}
  aria-describedby={`system-description-${id}`}
>
  <span class="observatory-node__dot" aria-hidden="true"></span>
  <span
    class="observatory-node__mark"
    data-system-mark
    aria-hidden="true"
  >
    <svg class="observatory-node__tracery" viewBox="0 0 100 100" aria-hidden="true"><circle data-motion-ring cx="50" cy="50" r="38" /><path data-motion-thread d={tracery[motionProfile || ''] || tracery.thread} /></svg>
    <img src={logo} alt="" loading="eager" decoding="async" />
  </span>
  <span class="observatory-node__label">{title}</span>
  <span class="observatory-node__summary" id={`system-description-${id}`}>{summary}</span>
</Tag>
