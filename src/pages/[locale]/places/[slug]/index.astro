---
import EntryLayout from "../../../../layouts/EntryLayout.astro";
import { getLocalizedCollection } from "../../../../i18n/content";
import { localizedPath } from "../../../../i18n/config";
import { getPlaceCodexRecord } from "../../../../utils/place-codex";

export async function getStaticPaths() {
  const entries = await getLocalizedCollection("places", "pt-br");
  return entries.map((entry) => ({
    params: { locale: "pt-br", slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const codex = await getPlaceCodexRecord(entry);
---

<EntryLayout
  active="places"
  entry={entry}
  locale="pt-br"
  codexAction={codex.exists ? {
    href: localizedPath("pt-br", `/places/${entry.slug}/codex/`),
    label: "Open Full Codex",
  } : null}
/>
