---
import type { ImageMetadata } from "astro";
import MainLayout from "../../layouts/MainLayout.astro";
import { getLocalizedCollection } from "../../i18n/content";
import { localizedPath, type SiteLocale } from "../../i18n/config";
import { getArchiveNavLabels, sectionLabel } from "../../i18n/ui";
import divinationPanelImage from "../../assets/uploads/systems/sys-divination-panel.png";
import redactoryPanelImage from "../../assets/uploads/systems/sys-redactory-panel.png";
import bloomPanelImage from "../../assets/uploads/systems/sys-bloom-panel.png";
import { getImageUrl } from "../../utils/optimized-images";

const { locale = "en" } = Astro.props as { locale?: SiteLocale };
const navLabels = getArchiveNavLabels(locale);

const copy = locale === "pt-br"
  ? {
      pageTitle: "Sistemas — SiNE Archives",
      identityTag: "Sistemas Fundamentais",
      identitySub: "Três faces do mesmo Archive",
      addendums: "Adendos",
      examine: "Examinar sistema",
      selectSystem: "Selecione um sistema para examinar",
      overlayEyebrow: "Sistemas · Adendos",
      close: "Fechar",
      entryCount: (n: number) => `${n} ${n === 1 ? "entrada" : "entradas"}`,
      noEntries: "Nenhuma entrada registrada.",
      bucketNames: {
        divination: "Divination",
        shared: "Compartilhado",
        redactory: "Redactory",
      },
    }
  : {
      pageTitle: "Systems — SiNE Archives",
      identityTag: "Fundamental Systems",
      identitySub: "Three faces of the same Archive",
      addendums: "Addendums",
      examine: "Examine system",
      selectSystem: "Select a system to examine",
      overlayEyebrow: "Systems · Addendums",
      close: "Close",
      entryCount: (n: number) => `${n} ${n === 1 ? "entry" : "entries"}`,
      noEntries: "No entries filed.",
      bucketNames: {
        divination: "Divination",
        shared: "Shared",
        redactory: "Redactory",
      },
    };

type SystemDef = {
  key: "divination" | "redactory" | "bloom";
  slug: string;
  name: string;
  subtitle: string;
  tagline: string;
  color: string;
  image: ImageMetadata;
  imagePosition: string;
  imageFilter: string;
};

const SYSTEMS: SystemDef[] = [
  {
    key: "divination",
    slug: "divinationsystem",
    name: "Divination",
    subtitle: locale === "pt-br" ? "Pressão Estrutural" : "Structural Pressure",
    tagline: locale === "pt-br"
      ? "Corpo, Mente e Alma · Receptáculo, Condutor e Fé."
      : "Body, Mind and Soul · Vessel, Conduit and Faith.",
    color: "#5878dc",
    image: divinationPanelImage,
    imagePosition: "54% center",
    imageFilter: "saturate(0.42) brightness(0.43) hue-rotate(188deg)",
  },
  {
    key: "redactory",
    slug: "redactorysystem",
    name: "Redactory",
    subtitle: locale === "pt-br" ? "Sobreposição Estrutural" : "Structural Overlay",
    tagline: locale === "pt-br"
      ? "Humano, Mente e Realidade · Pena, Tinta e Papel."
      : "Human, Mind and Reality · Pen, Ink and Paper.",
    color: "#bd493f",
    image: redactoryPanelImage,
    imagePosition: "center",
    imageFilter: "saturate(0.56) brightness(0.42)",
  },
  {
    key: "bloom",
    slug: "bloom",
    name: "Bloom",
    subtitle: locale === "pt-br" ? "Crescimento Estrutural" : "Structural Growth",
    tagline: locale === "pt-br"
      ? "Vida, Essência e Devir · Raiz, Néctar e Luz."
      : "Life, Essence and Becoming · Root, Nectar and Light.",
    color: "#b9974f",
    image: bloomPanelImage,
    imagePosition: "68% center",
    imageFilter: "saturate(0.72) brightness(0.54)",
  },
];

type AddendumBucket = "divination" | "redactory" | "shared";
type Addendum = {
  slug: string;
  title: string;
  type: string;
  summary: string;
  href: string;
  bucket: AddendumBucket;
  priority: number;
};

const EXCLUDED_ADDENDUM_SLUGS = new Set(["divinationsystem", "redactorysystem", "redactor", "bloom"]);
const ADDENDUM_PRIORITY: Record<string, number> = { resonance: 1 };
const systemsCollection = await getLocalizedCollection("systems", locale);
const lower = (arr: string[] | undefined) => (arr ?? []).map((tag) => tag.toLowerCase());

const ADDENDUMS: Addendum[] = systemsCollection
  .filter((entry) => entry.data.status === "public" && !EXCLUDED_ADDENDUM_SLUGS.has(entry.slug.toLowerCase()))
  .map((entry): Addendum => {
    const tags = lower(entry.data.tags);
    const hasDivination = tags.includes("divination");
    const hasRedactory = tags.includes("redactory");
    const bucket: AddendumBucket = hasDivination && hasRedactory
      ? "shared"
      : hasRedactory
        ? "redactory"
        : hasDivination
          ? "divination"
          : "shared";

    return {
      slug: entry.slug,
      title: entry.data.title,
      type: entry.data.type,
      summary: entry.data.summary ?? "",
      href: localizedPath(locale, `/systems/${entry.slug}/`),
      bucket,
      priority: ADDENDUM_PRIORITY[entry.slug.toLowerCase()] ?? 99,
    };
  })
  .sort((a, b) => a.priority - b.priority || a.title.localeCompare(b.title));

const ADDENDUM_COLS: { key: AddendumBucket; name: string; color: string; entries: Addendum[] }[] = [
  {
    key: "divination",
    name: copy.bucketNames.divination,
    color: SYSTEMS[0].color,
    entries: ADDENDUMS.filter((entry) => entry.bucket === "divination"),
  },
  {
    key: "shared",
    name: copy.bucketNames.shared,
    color: "#9aa0c4",
    entries: ADDENDUMS.filter((entry) => entry.bucket === "shared"),
  },
  {
    key: "redactory",
    name: copy.bucketNames.redactory,
    color: SYSTEMS[1].color,
    entries: ADDENDUMS.filter((entry) => entry.bucket === "redactory"),
  },
];
---

<MainLayout
  active="systems"
  pageTitle={copy.pageTitle}
  locale={locale}
  navVariant="section"
  navTrail={[
    { label: navLabels.index, href: localizedPath(locale, "/") },
    { label: sectionLabel(locale, "systems") },
  ]}
>
  <div class="sys-root">
    <header class="sys-identity">
      <div class="sys-rule"></div>
      <div class="sys-identity__center">
        <div class="sys-identity__tag">{copy.identityTag}</div>
        <div class="sys-identity__sub">{copy.identitySub}</div>
      </div>
      <button
        class="sys-entries-btn"
        id="sys-entries-open"
        type="button"
        aria-haspopup="dialog"
        aria-controls="sys-overlay"
      >
        {copy.addendums}
        <svg width="10" height="10" viewBox="0 0 10 10" fill="none" aria-hidden="true">
          <path d="M2 8 L8 2 M4 2 L8 2 L8 6" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </button>
      <div class="sys-rule sys-rule--right"></div>
    </header>

    <nav class="sys-panels" aria-label={copy.selectSystem}>
      {SYSTEMS.map((system, index) => (
        <a
          class={`sys-panel sys-panel--${system.key}`}
          href={localizedPath(locale, `/systems/${system.slug}/`)}
          style={`--accent: ${system.color}; --image-position: ${system.imagePosition}; --image-filter: ${system.imageFilter};`}
          aria-label={`${copy.examine}: ${system.name}`}
        >
          <span class="sys-panel__visual" aria-hidden="true">
            <img
              src={getImageUrl(system.image) ?? ""}
              alt=""
              loading={index === 0 ? "eager" : "lazy"}
              decoding="async"
            />
          </span>
          <span class="sys-panel__veil" aria-hidden="true"></span>
          <span class="sys-panel__glow" aria-hidden="true"></span>
          <span class="sys-panel__edge" aria-hidden="true"></span>
          <span class="sys-panel__content">
            <span class="sys-panel__subtitle">{system.subtitle}</span>
            <span class="sys-panel__name">{system.name}</span>
            <span class="sys-panel__tagline">{system.tagline}</span>
            <span class="sys-panel__cta">
              {copy.examine}
              <span aria-hidden="true">›</span>
            </span>
          </span>
        </a>
      ))}
    </nav>

    <div class="sys-caption" aria-hidden="true">
      <span>{copy.selectSystem}</span>
      <span class="sys-caption__mark">·</span>
      <span>I · II · III</span>
    </div>
  </div>

  <div
    class="sys-overlay"
    id="sys-overlay"
    role="dialog"
    aria-modal="true"
    aria-labelledby="sys-overlay-title"
    aria-hidden="true"
  >
    <div class="sys-overlay__head">
      <div>
        <div class="sys-overlay__eyebrow">{copy.overlayEyebrow}</div>
        <h2 class="sys-overlay__title" id="sys-overlay-title">{copy.addendums}</h2>
      </div>
      <button class="sys-overlay__close" id="sys-entries-close" type="button" aria-label={copy.close}>×</button>
    </div>

    <div class="sys-overlay__cols">
      {ADDENDUM_COLS.map((column, index) => (
        <section
          class="sys-overlay__col"
          style={`--accent: ${column.color};`}
          data-no-border={index === ADDENDUM_COLS.length - 1}
        >
          <div class="sys-overlay__colHead">
            <div class="sys-overlay__bar"></div>
            <div class="sys-overlay__colName">{column.name}</div>
            <div class="sys-overlay__colCount">{copy.entryCount(column.entries.length)}</div>
          </div>

          {column.entries.length === 0 && <div class="sys-overlay__empty">{copy.noEntries}</div>}

          <div class="sys-overlay__list">
            {column.entries.map((entry) => (
              <a class="sys-chip" href={entry.href}>
                <span>
                  <span class="sys-chip__type">{entry.type}</span>
                  <span class="sys-chip__title">{entry.title}</span>
                  <span class="sys-chip__summary">
                    {entry.summary.length > 110 ? `${entry.summary.slice(0, 110)}…` : entry.summary}
                  </span>
                </span>
                <span class="sys-chip__arrow" aria-hidden="true">›</span>
              </a>
            ))}
          </div>
        </section>
      ))}
    </div>
  </div>
</MainLayout>

<script is:inline>
  window.registerPageInit?.("systems-index-interactions", () => {
    const overlay = document.getElementById("sys-overlay");
    const openButton = document.getElementById("sys-entries-open");
    const closeButton = document.getElementById("sys-entries-close");
    if (!(overlay instanceof HTMLElement)) return;

    const controller = new AbortController();
    const listenerOptions = { signal: controller.signal };
    let previouslyFocused = null;

    const openOverlay = () => {
      previouslyFocused = document.activeElement;
      overlay.classList.add("is-open");
      overlay.setAttribute("aria-hidden", "false");
      document.body.style.overflow = "hidden";
      requestAnimationFrame(() => closeButton?.focus());
    };

    const closeOverlay = () => {
      overlay.classList.remove("is-open");
      overlay.setAttribute("aria-hidden", "true");
      document.body.style.overflow = "";
      if (previouslyFocused instanceof HTMLElement) previouslyFocused.focus();
      previouslyFocused = null;
    };

    openButton?.addEventListener("click", openOverlay, listenerOptions);
    closeButton?.addEventListener("click", closeOverlay, listenerOptions);
    overlay.addEventListener("click", (event) => {
      if (event.target === overlay) closeOverlay();
    }, listenerOptions);
    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && overlay.classList.contains("is-open")) closeOverlay();
    }, listenerOptions);

    return () => {
      controller.abort();
      overlay.classList.remove("is-open");
      overlay.setAttribute("aria-hidden", "true");
      document.body.style.overflow = "";
    };
  });
</script>

<style>
  .sys-root {
    display: flex;
    flex-direction: column;
    height: calc(100svh - var(--nav-height, 56px));
    min-height: 620px;
    overflow: hidden;
    background: #030306;
  }

  .sys-identity {
    position: relative;
    z-index: 10;
    display: flex;
    align-items: center;
    min-height: 66px;
    padding: 10px 48px;
    flex-shrink: 0;
    background: rgba(3, 3, 6, 0.96);
    border-bottom: 1px solid rgba(255, 255, 255, 0.045);
  }

  .sys-rule {
    flex: 1;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.075));
  }

  .sys-rule--right {
    background: linear-gradient(90deg, rgba(255, 255, 255, 0.075), transparent);
  }

  .sys-identity__center {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    min-width: 280px;
    padding: 0 38px;
  }

  .sys-identity__tag {
    font-family: "DM Sans", sans-serif;
    font-size: 8px;
    font-weight: 600;
    letter-spacing: 0.34em;
    text-transform: uppercase;
    color: rgba(232, 228, 220, 0.28);
  }

  .sys-identity__sub {
    font-family: "Cormorant Garamond", serif;
    font-size: 13px;
    font-style: italic;
    color: rgba(232, 228, 220, 0.42);
  }

  .sys-entries-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    flex-shrink: 0;
    margin: 0 30px;
    padding: 8px 14px;
    border: 1px solid rgba(255, 255, 255, 0.09);
    border-radius: 2px;
    background: rgba(255, 255, 255, 0.012);
    color: rgba(232, 228, 220, 0.4);
    font-family: "DM Sans", sans-serif;
    font-size: 8px;
    font-weight: 600;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    cursor: pointer;
    transition: color 220ms ease, border-color 220ms ease, background 220ms ease;
  }

  .sys-entries-btn:hover,
  .sys-entries-btn:focus-visible {
    color: var(--text);
    border-color: rgba(176, 141, 60, 0.45);
    background: rgba(176, 141, 60, 0.05);
    outline: none;
  }

  .sys-panels {
    display: flex;
    flex: 1;
    min-height: 0;
    width: calc(100% + 18vw);
    margin-inline: -9vw;
    overflow: hidden;
    background: #030306;
  }

  .sys-panel {
    position: relative;
    isolation: isolate;
    container-type: inline-size;
    display: flex;
    align-items: center;
    justify-content: center;
    flex: 1 1 0;
    min-width: 0;
    overflow: hidden;
    transform: skewX(-15deg);
    color: var(--text);
    text-decoration: none;
    outline: none;
    background: #06060a;
    box-shadow: 14px 0 36px rgba(0, 0, 0, 0.58);
    transition: flex-grow 720ms cubic-bezier(0.2, 0.82, 0.22, 1), filter 500ms ease;
  }

  .sys-panel:first-child {
    padding-left: 7vw;
  }

  .sys-panel:last-child {
    padding-right: 7vw;
  }

  .sys-panels:hover .sys-panel:not(:hover),
  .sys-panels:focus-within .sys-panel:not(:focus-visible) {
    filter: brightness(0.58) saturate(0.72);
  }

  .sys-panel:hover,
  .sys-panel:focus-visible {
    flex-grow: 1.42;
    z-index: 3;
  }

  .sys-panel__visual,
  .sys-panel__veil,
  .sys-panel__glow {
    position: absolute;
    inset: -8% -15%;
    transform: skewX(15deg);
    pointer-events: none;
  }

  .sys-panel__visual img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--image-position);
    opacity: 0.76;
    filter: var(--image-filter);
    transform: scale(1.035);
    transition: transform 900ms cubic-bezier(0.2, 0.82, 0.22, 1), opacity 560ms ease, filter 560ms ease;
  }

  .sys-panel:hover .sys-panel__visual img,
  .sys-panel:focus-visible .sys-panel__visual img {
    opacity: 1;
    filter: saturate(0.9) brightness(0.68);
    transform: scale(1.095) translateX(1.2%);
  }

  .sys-panel__veil {
    z-index: 1;
    background:
      linear-gradient(180deg, rgba(2, 2, 5, 0.3) 0%, rgba(2, 2, 5, 0.04) 42%, rgba(2, 2, 5, 0.72) 100%),
      linear-gradient(90deg, rgba(2, 2, 5, 0.55), transparent 45%, rgba(2, 2, 5, 0.42));
    transition: opacity 500ms ease;
  }

  .sys-panel:hover .sys-panel__veil,
  .sys-panel:focus-visible .sys-panel__veil {
    opacity: 0.68;
  }

  .sys-panel__glow {
    z-index: 2;
    opacity: 0.18;
    background: radial-gradient(ellipse at 50% 56%, color-mix(in srgb, var(--accent) 25%, transparent), transparent 62%);
    transition: opacity 500ms ease;
  }

  .sys-panel:hover .sys-panel__glow,
  .sys-panel:focus-visible .sys-panel__glow {
    opacity: 0.78;
  }

  .sys-panel__edge {
    position: absolute;
    z-index: 5;
    top: 0;
    right: 0;
    bottom: 0;
    width: 1px;
    background: linear-gradient(180deg, transparent, var(--accent) 18%, rgba(232, 228, 220, 0.7) 52%, var(--accent) 82%, transparent);
    box-shadow: 0 0 14px color-mix(in srgb, var(--accent) 52%, transparent);
    opacity: 0.55;
    transition: opacity 360ms ease, box-shadow 360ms ease;
  }

  .sys-panel:hover .sys-panel__edge,
  .sys-panel:focus-visible .sys-panel__edge {
    opacity: 1;
    box-shadow: 0 0 24px var(--accent);
  }

  .sys-panel:last-child .sys-panel__edge {
    display: none;
  }

  .sys-panel__content {
    position: relative;
    z-index: 4;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    max-width: min(34vw, 560px);
    padding: 34px;
    text-align: center;
    transform: skewX(15deg) translateY(7px);
    transition: transform 600ms cubic-bezier(0.2, 0.82, 0.22, 1);
  }

  .sys-panel:hover .sys-panel__content,
  .sys-panel:focus-visible .sys-panel__content {
    transform: skewX(15deg) translateY(0);
  }

  .sys-panels:has(.sys-panel:hover) .sys-panel:first-child:not(:hover) .sys-panel__content,
  .sys-panels:has(.sys-panel:focus-visible) .sys-panel:first-child:not(:focus-visible) .sys-panel__content {
    transform: skewX(15deg) translate(10vw, 7px);
  }

  .sys-panels:has(.sys-panel:hover) .sys-panel:last-child:not(:hover) .sys-panel__content,
  .sys-panels:has(.sys-panel:focus-visible) .sys-panel:last-child:not(:focus-visible) .sys-panel__content {
    transform: skewX(15deg) translate(-10vw, 7px);
  }

  .sys-panel__subtitle {
    font-family: "DM Sans", sans-serif;
    font-size: 9px;
    font-weight: 600;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--accent);
    opacity: 0.65;
    transition: opacity 300ms ease, letter-spacing 600ms cubic-bezier(0.2, 0.82, 0.22, 1);
  }

  .sys-panel__name {
    font-family: "Cormorant Garamond", serif;
    font-size: clamp(38px, 16cqi, 88px);
    font-weight: 600;
    line-height: 0.9;
    letter-spacing: 0.045em;
    text-shadow: 0 8px 32px rgba(0, 0, 0, 0.85);
    transition: letter-spacing 680ms cubic-bezier(0.2, 0.82, 0.22, 1), text-shadow 400ms ease;
  }

  .sys-panel__tagline {
    max-width: 380px;
    font-family: "Cormorant Garamond", serif;
    font-size: clamp(13px, 1.1vw, 17px);
    font-style: italic;
    line-height: 1.45;
    color: rgba(232, 228, 220, 0.66);
    opacity: 0;
    transform: translateY(10px);
    transition: opacity 360ms ease, transform 480ms cubic-bezier(0.2, 0.82, 0.22, 1);
  }

  .sys-panel__cta {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    margin-top: 3px;
    padding: 8px 15px;
    border: 1px solid color-mix(in srgb, var(--accent) 55%, transparent);
    border-radius: 2px;
    background: rgba(2, 2, 5, 0.35);
    color: var(--accent);
    font-family: "DM Sans", sans-serif;
    font-size: 9px;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    opacity: 0;
    transform: translateY(8px);
    transition: opacity 320ms ease 40ms, transform 460ms cubic-bezier(0.2, 0.82, 0.22, 1) 40ms, background 220ms ease;
  }

  .sys-panel:hover .sys-panel__subtitle,
  .sys-panel:focus-visible .sys-panel__subtitle {
    opacity: 1;
    letter-spacing: 0.34em;
  }

  .sys-panel:hover .sys-panel__name,
  .sys-panel:focus-visible .sys-panel__name {
    letter-spacing: 0.075em;
    text-shadow: 0 0 46px color-mix(in srgb, var(--accent) 28%, transparent), 0 8px 34px rgba(0, 0, 0, 0.9);
  }

  .sys-panel:hover .sys-panel__tagline,
  .sys-panel:focus-visible .sys-panel__tagline,
  .sys-panel:hover .sys-panel__cta,
  .sys-panel:focus-visible .sys-panel__cta {
    opacity: 1;
    transform: translateY(0);
  }

  .sys-panel:active .sys-panel__visual img {
    transform: scale(1.075) translateX(1.2%);
    transition-duration: 160ms;
  }

  .sys-panel:focus-visible::after {
    content: "";
    position: absolute;
    z-index: 8;
    inset: 7px;
    border: 1px solid color-mix(in srgb, var(--accent) 78%, white 12%);
    pointer-events: none;
  }

  .sys-caption {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 14px;
    min-height: 42px;
    padding: 8px 30px;
    flex-shrink: 0;
    border-top: 1px solid rgba(255, 255, 255, 0.045);
    background: rgba(3, 3, 6, 0.98);
    color: rgba(232, 228, 220, 0.17);
    font-family: "DM Sans", sans-serif;
    font-size: 8px;
    letter-spacing: 0.24em;
    text-transform: uppercase;
  }

  .sys-caption__mark {
    color: rgba(255, 255, 255, 0.1);
  }

  .sys-overlay {
    position: fixed;
    inset: 0;
    z-index: 300;
    display: flex;
    flex-direction: column;
    background: rgba(3, 3, 8, 0.95);
    backdrop-filter: blur(20px);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transform: translateY(12px);
    transition: opacity 320ms ease, transform 420ms cubic-bezier(0.2, 0.82, 0.22, 1), visibility 0s linear 420ms;
  }

  .sys-overlay.is-open {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: none;
    transition-delay: 0s;
  }

  .sys-overlay__head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    padding: 32px 52px 24px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.07);
    flex-shrink: 0;
  }

  .sys-overlay__eyebrow {
    margin-bottom: 8px;
    color: rgba(232, 228, 220, 0.3);
    font-family: "DM Sans", sans-serif;
    font-size: 9px;
    font-weight: 600;
    letter-spacing: 0.28em;
    text-transform: uppercase;
  }

  .sys-overlay__title {
    margin: 0;
    color: var(--text);
    font-family: "Cormorant Garamond", serif;
