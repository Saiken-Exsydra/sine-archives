---
import MainLayout from "../../layouts/MainLayout.astro";
import ArchiveRecord from "../../components/experiments/onlook/ArchiveRecord";

// Astro ignores directories beginning with "_". Emit these explicit lab paths instead.
export function getStaticPaths() {
  return [
    { params: { lab: "_lab" }, props: { locale: "en" as const } },
    { params: { lab: "pt-br/_lab" }, props: { locale: "pt-br" as const } },
  ];
}
const { locale } = Astro.props;
---
<MainLayout pageTitle="Onlook Lab · SiNE Archives" locale={locale} active="systems" routeKind="generic" hideFooter>
  <meta slot="head" name="robots" content="noindex, nofollow, noarchive" />
  <ArchiveRecord locale={locale} client:load />
</MainLayout>
