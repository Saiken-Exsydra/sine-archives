---
import EntryLayout from "../../../layouts/EntryLayout.astro";
import { getLocalizedCollection } from "../../../i18n/content";
import { localizedPath } from "../../../i18n/config";
import { getCosmologyCodexRecord } from "../../../utils/cosmology-codex";

export async function getStaticPaths() {
  const entries = await getLocalizedCollection("cosmology", "en");
  return entries
    .filter((e) => e.data.status === "public")
    .map((entry) => ({
      params: { slug: entry.slug },
      props: { entry },
    }));
}

const { entry } = Astro.props;
const codex = await getCosmologyCodexRecord(entry);
---

<EntryLayout
  active="cosmology"
  entry={entry}
  locale="en"
  codexAction={codex.exists ? {
    href: localizedPath("en", `/cosmology/${entry.slug}/codex/`),
    label: "Open Full Codex",
  } : null}
/>
