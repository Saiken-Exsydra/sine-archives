{
  "name": "sine-react-systems",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "check": "tsc --noEmit",
    "build": "npm run assets:check && npm run content:check && npm run check && vite build",
    "review": "node tools/content/review.mjs",
    "test": "playwright test",
    "content:check": "node tools/content/characters.mjs",
    "content:test": "node --test tools/content/characters.test.mjs tools/content/review-preview.test.mjs",
    "archive:check": "node tools/archive/check.mjs",
    "archive:test": "node --test tools/archive/sources.test.mjs",
    "assets:sync": "node tools/assets/cli.mjs sync",
    "assets:dry-run": "node tools/assets/cli.mjs dry-run",
    "assets:check": "node tools/assets/cli.mjs check",
    "assets:report": "node tools/assets/cli.mjs report",
    "assets:rebuild": "node tools/assets/cli.mjs rebuild",
    "assets:test": "node --test tools/assets/engine.test.mjs"
  },
  "dependencies": {
    "gsap": "^3.15.0",
    "motion": "^14.14.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "^4.6.7",
    "marked": "16.4.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/node": "^25.9.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "sharp": "^0.35.5",
    "typescript": "^5.9.3",
    "vite": "6.4.6"
  }
}
